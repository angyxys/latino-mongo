incluir("mongo")

escribir("========== CONEXION ==========")
r = mongo.conectar("mongodb://localhost:27017", "tienda")
escribir("conectado: "..r)

escribir("")
escribir("========== INSERCION ==========")

mongo.insertar("productos", {
  "nombre": "Cafe",
  "precio": 85.5,
  "stock": 120,
  "tags": ["caliente", "importado"],
  "origen": {"pais": "Colombia", "region": "Huila"}
})
escribir("insertado: Cafe")

n = mongo.insertar_varios("productos", [
  {"nombre": "Te", "precio": 50, "stock": 80, "tags": ["caliente"], "origen": {"pais": "Argentina"}},
  {"nombre": "Azucar", "precio": 25, "stock": 200, "tags": [], "origen": {"pais": "Mexico"}}
])
escribir("insertados en lote: "..n)

escribir("")
escribir("========== BUSQUEDA INDIVIDUAL ==========")

doc = mongo.buscar_uno("productos", {"nombre": "Cafe"})
escribir("nombre:   "..doc.nombre)
escribir("precio:   "..acadena(doc.precio))
escribir("stock:    "..doc.stock)
escribir("pais:     "..doc.origen.pais)
escribir("tag[0]:   "..doc.tags[0])
escribir(doc)

escribir("")
escribir("========== BUSQUEDA MULTIPLE ==========")

total = mongo.contar("productos", {})
escribir("productos en la coleccion: "..total)

todos = mongo.buscar("productos", {})
i = 0
mientras i < total
  p = todos[i]
  escribir("  - "..p.nombre.." ($"..acadena(p.precio)..")")
  i = i + 1
fin

escribir("")
escribir("========== CONTEOS CON FILTROS ==========")
escribir("precio > 40:      "..mongo.contar("productos", {"precio": {"$gt": 40}}))
escribir("origen Colombia:  "..mongo.contar("productos", {"origen.pais": "Colombia"}))
escribir("con tag caliente: "..mongo.contar("productos", {"tags": "caliente"}))

escribir("")
escribir("========== ACTUALIZACION ==========")
antes = mongo.buscar_uno("productos", {"nombre": "Te"})
escribir("Te stock ANTES:   "..antes.stock)

m = mongo.actualizar("productos", {"nombre": "Te"}, {"$set": {"stock": 75}})
escribir("modificados:      "..m)

despues = mongo.buscar_uno("productos", {"nombre": "Te"})
escribir("Te stock DESPUES: "..despues.stock)

escribir("")
escribir("========== ELIMINACION ==========")
d = mongo.eliminar("productos", {"nombre": "Azucar"})
escribir("eliminados: "..d)
escribir("quedan:     "..mongo.contar("productos", {}))

mongo.desconectar()
escribir("")
escribir("========== DEMO COMPLETO ==========")
